# Optional. If set, the UI exposes a "Use Claude" toggle that routes
# generation through the Anthropic API for higher-quality output.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Override the Claude model. Defaults to claude-haiku-4-5-20251001.
LYRIC_MODEL=

# Optional. Server port. Defaults to 3000.
PORT=3000
